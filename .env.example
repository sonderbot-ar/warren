# Copy to .env and fill in. .env is git-ignored.

# SEC EDGAR requires a descriptive User-Agent with a name and contact email (used from M1).
SEC_USER_AGENT="Your Name your.email@example.com"

# Anthropic API key for the LLM steps (M6, Decision 1). Paid per token; the owner provides it.
# In cloud environments use the name WARREN_ANTHROPIC_API_KEY: the cloud keeps ANTHROPIC_API_KEY
# for Claude Code's own sign-in. Locally either name works; WARREN_ANTHROPIC_API_KEY wins if both.
WARREN_ANTHROPIC_API_KEY=
